{
  "name": "emd-destock",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @emd/mobile dev",
    "dev:admin": "pnpm --filter @emd/admin dev",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "test": "supabase test db && pnpm --filter @emd/shared test",
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "supabase": "^2.120.0",
    "typescript-eslint": "^8.71.1"
  }
}
