# Copier vers .env.local (non versionné). Ne jamais committer de secret.

# Supabase (valeurs locales affichées par `supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Serveur uniquement (Edge Functions, routes serveur Next.js). Jamais dans l'app mobile.
SUPABASE_SERVICE_ROLE_KEY=

# Variables exposées aux apps
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API Sirene (Insee), lot 1
INSEE_API_KEY=

# Resend, lots 1 et 3. L'expéditeur dépend d'un domaine encore à configurer.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# Comptes de démonstration créés par supabase/seed.sql (local uniquement, aussi pour la revue Apple)
DEMO_ADMIN_EMAIL=admin@emd-destock.test
DEMO_ADMIN_PASSWORD=AdminDemo2026!
DEMO_CLIENT_EMAIL=demo-client@emd-destock.test
DEMO_CLIENT_PASSWORD=ClientDemo2026!
