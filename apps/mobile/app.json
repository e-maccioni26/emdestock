{
  "expo": {
    "name": "EMD DESTOCK",
    "slug": "emd-destock",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "emd-destock",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "fr.emddestock.app",
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
